{
  "name": "distrohub",
  "version": "1.0.0",
  "private": true,
  "description": "DistroHub — интерактивный каталог и навигатор по дистрибутивам Linux",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "seed": "tsx scripts/seed-demo.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:offline": "node offline/build.mjs",
    "postbuild": "node scripts/prepare-standalone.mjs"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "bcryptjs": "3.0.3",
    "jose": "6.2.14",
    "lucide-react": "1.64.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=22.12"
  }
}
